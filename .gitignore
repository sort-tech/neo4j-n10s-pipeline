# Neo4j runtime data & logs
data/*
!data/.gitkeep
logs/*
!logs/.gitkeep

# Neo4j plugins (JAR binaries)
plugins/*.jar
!plugins/.gitkeep

# Force include scripts (unignore if overridden by global gitignore)
!scripts/
!scripts/**

# Generated visualisations (`python3 -m viz draw`)
out/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Environment & config
.env
.env.*
!.env.example

# OS & Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
